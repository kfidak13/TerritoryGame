{
  "name": "borderfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @borderfall/server\" \"npm run dev -w @borderfall/client\"",
    "build": "npm run build -w @borderfall/client",
    "start": "npm run start -w @borderfall/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "concurrently": "10.0.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
